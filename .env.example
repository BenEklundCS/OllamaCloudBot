# Discord Bot Token (from Discord Developer Portal > Your App > Bot > Token)
DISCORD_TOKEN=

# GitHub App - created at https://github.com/settings/apps/new
# App ID shown on your GitHub App's settings page
GITHUB_APP_ID=
# Path to the .pem private key downloaded from GitHub App settings
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# Installation ID - after installing your app on the repo, visit:
#   https://api.github.com/repos/OWNER/REPO/installation
# and copy the "id" field, or find it in the install URL on github.com/settings/installations
GITHUB_INSTALLATION_ID=
# The single repo this bot can access (owner/repo format)
GITHUB_REPO=owner/repo-name

# Ollama Cloud - OpenAI-compatible endpoint
OLLAMA_CLOUD_API_KEY=
OLLAMA_BASE_URL=https://api.ollama.ai/v1
OLLAMA_MODEL=deepseek-v4-pro
